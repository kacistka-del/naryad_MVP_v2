# ============ Сервер ============
PORT=8080
NODE_ENV=production
APP_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
# Разрешённые origin через запятую; пусто = отражать origin запроса
CORS_ORIGIN=

# ============ База данных ============
DATABASE_URL=postgres://naryad:naryad@localhost:5432/naryad

# ============ Авторизация ============
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
REQUIRE_EMAIL_VERIFICATION=true

# Первый администратор (npm run seed)
ADMIN_EMAIL=admin@naryad.local
ADMIN_PASSWORD=change_me

# Google OAuth (необязательно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============ Почта ============
# Без SMTP коды и ссылки печатаются в лог сервера
SMTP_URL=
MAIL_FROM="NARYAD <no-reply@naryad.local>"

# ============ Файлы ============
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ============ Валюты ============
# Базовая валюта внутреннего учёта (все суммы в леджере хранятся и в ней)
BASE_CURRENCY=EUR
# Как часто обновлять курсы, минут
FX_TTL_MINUTES=360
# Наценка на конвертацию при реальных списаниях, % (0 = без наценки)
FX_SPREAD_PERCENT=0

# ============ ИИ ============
# Приоритет провайдеров через запятую. rules всегда работает и всегда последний.
AI_PROVIDERS=ollama,openai_compatible,rules

# Локальная модель (бесплатно, без ключей): docker run -d -p 11434:11434 ollama/ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Любой OpenAI-совместимый API: OpenAI, OpenRouter, Groq, Together, локальный vLLM
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# ============ Монетизация ============
# Комиссия берётся ТОЛЬКО с онлайн-сделок. Наличные — всегда бесплатно.
ESCROW_COMMISSION_PERCENT=8
# Сколько месяцев Pro даётся по пакету «Основатель»
FOUNDER_PRO_MONTHS=3
# Лимит мест в программе «Основатель»
FOUNDER_SLOTS=100

# Платёжные провайдеры по странам. Пусто = режим manual (счёт вручную).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ============ Сервисные задачи ============
# Токен для cron-вызова /api/functions/runPlanner и /api/fx/refresh
CRON_TOKEN=
